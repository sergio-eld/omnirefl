@PACKAGE_INIT@

set(@PROJECT_NAME@_RESOURCE_DIR 
    "${PACKAGE_PREFIX_DIR}/share/@PROJECT_NAME@/clang/@LLVM_VERSION@")
if (NOT EXISTS "${@PROJECT_NAME@_RESOURCE_DIR}/include")
    message(FATAL_ERROR "\
@PROJECT_NAME@: Resource dir ${@PROJECT_NAME@_RESOURCE_DIR} \
for tool's headers was not found or doesn't exist")
else()
    message(STATUS "\
@PROJECT_NAME@: Found resource dir with tool's headers: \
\"${@PROJECT_NAME@_RESOURCE_DIR}\"\
")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/reflected_target.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

if(CMAKE_HOST_WIN32)
    set_target_properties(omni::tool PROPERTIES
        IMPORTED_LOCATION_RELEASE "${PACKAGE_PREFIX_DIR}/bin/@PROJECT_NAME@.exe")
    set_target_properties(omni::ccdb_query PROPERTIES
        IMPORTED_LOCATION_RELEASE "${PACKAGE_PREFIX_DIR}/bin/ccdb_query.exe")
endif()

if (NOT TARGET omni::refl)
    message(FATAL_ERROR "@PROJECT_NAME@ error: target not found")
endif()

# Register each new component here and install its configuration as
# `components/<name>.cmake`. The component configuration must find its
# dependencies and set `@PROJECT_NAME@_<name>_FOUND`; when unavailable, it must
# also set `@PROJECT_NAME@_<name>_NOT_FOUND_MESSAGE`.
set(_@PROJECT_NAME@_supported_components)

foreach(_component IN LISTS @PROJECT_NAME@_FIND_COMPONENTS)
    if(_component IN_LIST _@PROJECT_NAME@_supported_components)
        include("${CMAKE_CURRENT_LIST_DIR}/components/${_component}.cmake")
    else()
        set(@PROJECT_NAME@_${_component}_FOUND FALSE)
        set(@PROJECT_NAME@_${_component}_NOT_FOUND_MESSAGE
            "Unsupported @PROJECT_NAME@ component '${_component}'")
    endif()

    if(@PROJECT_NAME@_FIND_REQUIRED_${_component}
        AND NOT @PROJECT_NAME@_${_component}_FOUND)
        string(APPEND @PROJECT_NAME@_NOT_FOUND_MESSAGE
            "${@PROJECT_NAME@_${_component}_NOT_FOUND_MESSAGE}\n")
    endif()
endforeach()

check_required_components(@PROJECT_NAME@)

