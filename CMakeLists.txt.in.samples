cmake_minimum_required(VERSION 3.14.2 FATAL_ERROR)
project(@PROJECT_NAME@.samples LANGUAGES CXX C VERSION @PROJECT_VERSION@)

# todo: option for CMAKE_CXX_STANDARD with 17 as default
set(CMAKE_CXX_STANDARD 17)

find_package(@PROJECT_NAME@ CONFIG REQUIRED)
# todo: add example here, which must provide a simple sanity check (generated and compiled)

find_package(GTest CONFIG QUIET)
if (TARGET GTest::gtest)
    enable_testing()

    add_executable(${PROJECT_NAME}.test.impl_ryml test/test_impl_ryml.cpp)
    reflected_target(${PROJECT_NAME}.test.impl_ryml)
    target_include_directories(${PROJECT_NAME}.test.impl_ryml PRIVATE test)
    target_link_libraries(${PROJECT_NAME}.test.impl_ryml PRIVATE GTest::gtest)
endif()

