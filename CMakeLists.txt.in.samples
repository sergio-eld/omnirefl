cmake_minimum_required(VERSION 3.11.4 FATAL_ERROR)
project(@PROJECT_NAME@.samples LANGUAGES CXX C VERSION @PROJECT_VERSION@)

# todo: use C++11, detect supported standards and build a matrix
set(CMAKE_CXX_STANDARD 14)
set(CMAKE_CXX_STANDARD_REQUIRED TRUE)

find_package(@PROJECT_NAME@ CONFIG REQUIRED)
# todo: add example here, which must provide a simple sanity check (generated and compiled)

find_package(GTest QUIET)
if (NOT TARGET GTest::GTest)
    include(FetchContent)
    FetchContent_Declare(
        googletest
        GIT_REPOSITORY https://github.com/google/googletest.git
        GIT_TAG v1.15.2
    )
    # For Windows: Prevent overriding the parent project's compiler/linker settings
    set(gtest_force_shared_crt ON CACHE BOOL "" FORCE)
    FetchContent_MakeAvailable(googletest)
    add_library(GTest::GTest ALIAS gtest)
endif()

set(TEST_NAME ${PROJECT_NAME}.test) 
enable_testing()

message(STATUS "@PROJECT_NAME@.samples: enabled testing")

add_executable(${TEST_NAME}.simple test/simple/test.cpp)
reflected_target(${TEST_NAME}.simple)
target_include_directories(${TEST_NAME}.simple PRIVATE test/simple)
target_link_libraries(${TEST_NAME}.simple PRIVATE GTest::gtest)
add_test(NAME ${TEST_NAME}.simple COMMAND ${TEST_NAME}.simple)

