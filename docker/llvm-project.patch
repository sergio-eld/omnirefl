# Downstream LLVM compatibility changes used by the Docker images.
#
# The same patch is applied when producing the Alpine musl and Cosmopolitan
# LLVM artifacts. Cosmopolitan-specific changes are guarded by
# __COSMOPOLITAN__, while the remaining changes are portable and required by
# the bundled libc++ headers shared with other Linux environments.
#
# LLVM support library changes:
#
# - ADT/bit.h: Cosmopolitan provides the byte-order macros through endian.h,
#   like the other Unix platforms in this branch.
# - Unix/Path.inc: Cosmopolitan's statvfs uses f_flag; its executable path is
#   obtained through GetProgramExecutableName(); and it has no portable
#   equivalent of LLVM's local-filesystem test, so the conservative answer is
#   used.
# - Unix/Signals.inc: Cosmopolitan does not provide the dladdr-based symbol
#   lookup used by this stack-trace path. The existing address-only fallback is
#   retained instead.
# - VirtualOutputBackends.cpp: explicitly construct the error_condition before
#   comparing it with the error_code. Cosmopolitan's libc++ does not accept the
#   direct error_code/errc comparison, while the explicit standard conversion
#   has the same meaning on the other targets.
#
# libc++ header portability change:
#
# - __config_site.in normally freezes _LIBCPP_HAS_MUSL_LIBC when the headers
#   are generated. These generated headers are bundled with omnirefl and may be
#   consumed on either musl or glibc. Re-evaluate the setting at consumer
#   preprocessing time from the musl-specific bits/alltypes.h header. This also
#   resolves to false for Cosmopolitan.
#
# This patch modifies LLVM project source and remains under the upstream LLVM
# project license.
# SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
# See https://llvm.org/LICENSE.txt.

diff --git a/llvm/include/llvm/ADT/bit.h b/llvm/include/llvm/ADT/bit.h
index 5971b7504..2d75df073 100644
--- a/llvm/include/llvm/ADT/bit.h
+++ b/llvm/include/llvm/ADT/bit.h
@@ -30,7 +30,8 @@
 
 #if defined(__linux__) || defined(__GNU__) || defined(__HAIKU__) ||            \
     defined(__Fuchsia__) || defined(__EMSCRIPTEN__) || defined(__NetBSD__) ||  \
-    defined(__OpenBSD__) || defined(__DragonFly__) || defined(__managarm__)
+    defined(__OpenBSD__) || defined(__DragonFly__) || defined(__managarm__) || \
+    defined(__COSMOPOLITAN__)
 #include <endian.h>
 #elif defined(_AIX)
 #include <sys/machine.h>
diff --git a/llvm/lib/Support/Unix/Path.inc b/llvm/lib/Support/Unix/Path.inc
index fc71ca46d..cede72c05 100644
--- a/llvm/lib/Support/Unix/Path.inc
+++ b/llvm/lib/Support/Unix/Path.inc
@@ -33,6 +33,10 @@
 #include <dirent.h>
 #include <pwd.h>
 
+#ifdef __COSMOPOLITAN__
+#include <libc/cosmo.h>
+#endif
+
 #ifdef __APPLE__
 #include <copyfile.h>
 #include <mach-o/dyld.h>
@@ -111,7 +115,7 @@ typedef uint_t uint;
 #endif
 
 #if defined(__NetBSD__) || defined(__DragonFly__) || defined(__GNU__) ||       \
-    defined(__MVS__)
+    defined(__MVS__) || defined(__COSMOPOLITAN__)
 #define STATVFS_F_FLAG(vfs) (vfs).f_flag
 #else
 #define STATVFS_F_FLAG(vfs) (vfs).f_flags
@@ -326,6 +330,9 @@ std::string getMainExecutable(const char *argv0, void *MainAddr) {
       return std::string(real_path);
     break; // Found entry, but realpath failed.
   }
+#elif defined(__COSMOPOLITAN__)
+  if (const char *Executable = GetProgramExecutableName())
+    return Executable;
 #elif defined(HAVE_DLOPEN)
   // Use dladdr to get executable path if available.
   Dl_info DLInfo;
@@ -560,9 +567,12 @@ static bool is_local_impl(struct STATVFS &Vfs) {
 
   // vmount entry not found; "remote" is the conservative answer.
   return false;
 #elif defined(__MVS__)
   // The file system can have an arbitrary structure on z/OS; must go with the
   // conservative answer.
   return false;
+#elif defined(__COSMOPOLITAN__)
+  // Cosmopolitan does not expose portable local-filesystem detection.
+  return false;
 #else
   return !!(STATVFS_F_FLAG(Vfs) & MNT_LOCAL);
diff --git a/llvm/lib/Support/Unix/Signals.inc b/llvm/lib/Support/Unix/Signals.inc
index 56ad4fc50..54cf6b2ff 100644
--- a/llvm/lib/Support/Unix/Signals.inc
+++ b/llvm/lib/Support/Unix/Signals.inc
@@ -860,7 +860,7 @@ void llvm::sys::PrintStackTrace(raw_ostream &OS, int Depth) {
   OS << "Stack dump without symbol names (ensure you have llvm-symbolizer in "
         "your PATH or set the environment var `LLVM_SYMBOLIZER_PATH` to point "
         "to it):\n";
-#if HAVE_DLOPEN && !defined(_AIX)
+#if HAVE_DLOPEN && !defined(_AIX) && !defined(__COSMOPOLITAN__)
   int width = 0;
   for (int i = 0; i < depth; ++i) {
     Dl_info dlinfo;
diff --git a/llvm/lib/Support/VirtualOutputBackends.cpp b/llvm/lib/Support/VirtualOutputBackends.cpp
index d7a91dfa1..1d7ab636c 100644
--- a/llvm/lib/Support/VirtualOutputBackends.cpp
+++ b/llvm/lib/Support/VirtualOutputBackends.cpp
@@ -244,7 +244,7 @@ static Error createDirectoriesOnDemand(StringRef OutputPath,
                                        OutputConfig Config,
                                        llvm::function_ref<Error()> CreateFile) {
   return handleErrors(CreateFile(), [&](std::unique_ptr<ECError> EC) {
-    if (EC->convertToErrorCode() != std::errc::no_such_file_or_directory ||
+    if (EC->convertToErrorCode() != std::make_error_condition(std::errc::no_such_file_or_directory) ||
         Config.getNoImplyCreateDirectories())
       return Error(std::move(EC));
 

diff --git a/libcxx/include/__config_site.in b/libcxx/include/__config_site.in
index 4b90a9dc3..7a439a31e 100644
--- a/libcxx/include/__config_site.in
+++ b/libcxx/include/__config_site.in
@@ -32,6 +32,17 @@
 #cmakedefine01 _LIBCPP_HAS_LOCALIZATION
 #cmakedefine01 _LIBCPP_HAS_UNICODE
 #cmakedefine01 _LIBCPP_HAS_WIDE_CHARACTERS
 #cmakedefine01 _LIBCPP_HAS_TIME_ZONE_DATABASE
 #cmakedefine01 _LIBCPP_INSTRUMENTED_WITH_ASAN
+// Package headers built on musl, but usable on glibc and vice-versa.
+// In libc++ 21+, _LIBCPP_HAS_MUSL_LIBC is typically defined via #cmakedefine01 (0/1),
+// so !defined(...) won't trigger. Fix it at preprocess time.
+#if defined(_LIBCPP_HAS_MUSL_LIBC) && defined(__has_include)
+#  undef _LIBCPP_HAS_MUSL_LIBC
+#  if __has_include(<bits/alltypes.h>)
+#    define _LIBCPP_HAS_MUSL_LIBC 1
+#  else
+#    define _LIBCPP_HAS_MUSL_LIBC 0
+#  endif
+#endif
 
 // PSTL backends
 #cmakedefine _LIBCPP_PSTL_BACKEND_SERIAL
